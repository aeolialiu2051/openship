# Vibrail Dashboard — local dev. Copy to `.env`; `dev` loads it (node --env-file=.env).
# Non-secret runtime config: the mode lives HERE, not in a wrapper script.
# VIBRAIL_TARGET selects the runtime-target row in packages/core/runtime-config.ts.
VIBRAIL_TARGET=local
VIBRAIL_CLOUD_TARGET=local-saas
PORT=3001
NEXT_DIST_DIR=.next
