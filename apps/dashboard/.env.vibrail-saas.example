# Vibrail Dashboard — localhost SaaS dev. Copy to `.env.vibrail-saas`;
# `dev:vibrail-saas` loads it. Serves on :3002 into a separate build directory.
VIBRAIL_TARGET=vibrail-saas
VIBRAIL_SITE_DOMAIN=example.com
VIBRAIL_APP_DOMAIN=app.example.com
VIBRAIL_CLOUD_DASHBOARD_URL=http://localhost:3002
VIBRAIL_CLOUD_API_URL=http://localhost:4100
PORT=3002
NEXT_DIST_DIR=.next-vibrail-saas
