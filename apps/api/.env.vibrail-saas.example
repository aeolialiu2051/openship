# Vibrail API — SaaS development example.
# Copy to .env.vibrail-saas for Vibrail SaaS development. Do not commit real secrets.
# `dev:vibrail-saas` loads this file in addition to the repository-level .env.
# No mode logic lives in a wrapper script.
#
# SINGLE knob — VIBRAIL_TARGET — picks the runtime-target row. The
# table at packages/core/src/runtime-config.ts is the source of URLs.
#   VIBRAIL_TARGET=local        → self-hosted (the .env default)
#   VIBRAIL_TARGET=vibrail-saas → Vibrail's hosted SaaS target
# Local development overrides the public endpoints back to localhost below.

NODE_ENV=development

VIBRAIL_TARGET=vibrail-saas
VIBRAIL_CLOUD_DASHBOARD_URL=http://localhost:3002
VIBRAIL_CLOUD_API_URL=http://localhost:4100
CLOUD_MODE=true
DEPLOY_MODE=cloud

# Isolated PGlite store so the localhost SaaS never shares data with self-hosted
# (~/.vibrail/data). Leading ~ is expanded by the db client.
PGLITE_DATA_DIR=~/.vibrail/data-saas

# DATABASE_URL — dev:vibrail-saas uses embedded PGlite (no Postgres needed)

BETTER_AUTH_SECRET=change-me-in-production

# Required outside desktop mode. Fronts trusted Electron↔API endpoints
# (/setup, /desktop-auth-start). Boot refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_TOKEN=change-me-32-byte-random-hex

# Required for cloud deployments.
OBLIEN_CLIENT_ID=
OBLIEN_CLIENT_SECRET=
# Returned by Oblien when the org's webhook is registered via
# client.webhooks.create. Used to verify HMAC on inbound deliveries to
# /api/billing/oblien-webhook. Without it the endpoint returns 503 — we
# never accept unverified webhook traffic. Operator action: register the
# webhook and persist the returned secret here.
OBLIEN_WEBHOOK_SECRET=

# Required for GitHub App mode.
GITHUB_APP_ID=
GITHUB_APP_SLUG=vibrail-io
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=

SYSTEM_DEBUG_LOGS=false
