# Throwaway self-hosted instance for the Docker-migration E2E test ONLY.
# Zero-auth (desktop + loopback) so localhost calls run as the local admin.
# Own PGlite dir so it never touches the girls-college data (~/.vibrail/data).
NODE_ENV=development
PORT=4300
VIBRAIL_TARGET=local
DEPLOY_MODE=desktop
VIBRAIL_ALLOW_ZERO_AUTH=true
PGLITE_DATA_DIR=/Users/infobrim/.vibrail/data-migtest
BETTER_AUTH_SECRET=migtest-secret-not-for-production-000000
BETTER_AUTH_URL=http://localhost:4300
VIBRAIL_REQUIRE_REDIS=false
VIBRAIL_API_HOST=127.0.0.1
