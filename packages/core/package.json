{
  "name": "@repo/core",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./runtime-config": {
      "types": "./src/runtime-config.ts",
      "import": "./src/runtime-config.ts"
    },
    "./updates": {
      "types": "./src/updates/index.ts",
      "import": "./src/updates/index.ts"
    },
    "./starter-template-metadata": {
      "types": "./src/starter-template-metadata.ts",
      "import": "./src/starter-template-metadata.ts"
    },
    "./starter-templates": {
      "types": "./src/starter-templates.ts",
      "import": "./src/starter-templates.ts"
    },
    "./managed-routing": {
      "types": "./src/managed-routing.ts",
      "import": "./src/managed-routing.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
