{
  "available": true,
  "verified": true,
  "id": "cli-proxy-api",
  "name": "CLIProxyAPI",
  "description": "OpenAI-compatible API proxy for CLI model providers, with persistent authentication and generated API access credentials.",
  "kind": "template",
  "logo": "cli-proxy-api",
  "category": "other",
  "tags": ["api", "proxy", "openai", "ai", "cli"],
  "framework": "docker-compose",
  "services": [
    {
      "name": "cli-proxy-api",
      "image": "eceasy/cli-proxy-api:latest",
      "ports": ["8317:8317"],
      "exposedPort": 8317,
      "exposed": true,
      "secretEnv": ["API_KEY", "MANAGEMENT_PASSWORD"],
      "volumes": [
        "cli_proxy_api_auth:/root/.cli-proxy-api",
        "cli_proxy_api_logs:/CLIProxyAPI/logs",
        "cli_proxy_api_plugins:/CLIProxyAPI/plugins"
      ],
      "restart": "unless-stopped"
    }
  ],
  "configFields": [
    {
      "key": "API_KEY",
      "service": "cli-proxy-api",
      "label": "API key",
      "help": "Auto-generated. Use this key to authenticate requests to the proxy API.",
      "generate": "secret",
      "secret": true
    },
    {
      "key": "MANAGEMENT_PASSWORD",
      "service": "cli-proxy-api",
      "label": "Management key",
      "help": "Auto-generated. Use this key to sign in to the CLIProxyAPI management center.",
      "generate": "secret",
      "secret": true
    }
  ],
  "files": [
    {
      "service": "cli-proxy-api",
      "path": "/CLIProxyAPI/config.yaml",
      "writable": true,
      "content": "host: 0.0.0.0\nport: 8317\nremote-management:\n  allow-remote: true\n  secret-key: \"\"\nauth-dir: /root/.cli-proxy-api\napi-keys:\n  - \"{{config:API_KEY}}\"\ndebug: false\nlogging-to-file: true\nusage-statistics-enabled: false\nplugins:\n  enabled: false\n  dir: /CLIProxyAPI/plugins\n"
    }
  ],
  "connection": {
    "title": {
      "en": "Connect to CLIProxyAPI",
      "zh": "连接 CLIProxyAPI"
    },
    "description": {
      "en": "Use the OpenAI-compatible endpoint in your clients and manage provider accounts from the protected CLIProxyAPI management center.",
      "zh": "在客户端中使用 OpenAI 兼容接口，并通过受保护的 CLIProxyAPI 管理中心管理服务商账号。"
    },
    "outputs": [
      {
        "id": "baseUrl",
        "label": {
          "en": "OpenAI base URL",
          "zh": "OpenAI 基础地址"
        },
        "source": "template:{{publicUrl:cli-proxy-api}}/v1",
        "service": "cli-proxy-api",
        "envKey": "OPENAI_BASE_URL",
        "recommended": true
      },
      {
        "id": "apiKey",
        "label": {
          "en": "API key",
          "zh": "API 密钥"
        },
        "source": "env:cli-proxy-api:API_KEY",
        "secret": true,
        "envKey": "OPENAI_API_KEY",
        "recommended": true
      },
      {
        "id": "managementUrl",
        "label": {
          "en": "Management center",
          "zh": "管理中心"
        },
        "source": "template:{{publicUrl:cli-proxy-api}}/management.html",
        "service": "cli-proxy-api",
        "recommended": true
      },
      {
        "id": "managementKey",
        "label": {
          "en": "Management key",
          "zh": "管理密钥"
        },
        "source": "env:cli-proxy-api:MANAGEMENT_PASSWORD",
        "secret": true,
        "envKey": "CLIPROXY_MANAGEMENT_KEY",
        "recommended": true
      }
    ]
  },
  "provides": [
    {
      "id": "openai-compatible-api",
      "category": "ai-api",
      "outputRefs": ["baseUrl", "apiKey"]
    }
  ],
  "endpoints": [
    {
      "service": "cli-proxy-api",
      "port": 8317,
      "label": "OpenAI-compatible API",
      "kind": "http",
      "scope": "public",
      "defaultMode": "domain",
      "allowedModes": ["domain", "port"]
    }
  ]
}
